# Copy to .env and fill in real values. Never commit .env.

# Telegram bot token from @BotFather (required).
BOT_TOKEN=

# Target group for escalations and the morning greeting.
GROUP_CHAT_ID=-1001234567890

# Comma-separated Telegram user IDs allowed to run admin commands.
ADMIN_IDS=123456789

BOT_USERNAME=oz_support_bot
MORNING_TIME_UTC=03:00

# SQLAlchemy URL. SQLite is the default; PostgreSQL also works with Alembic.
DATABASE_URL=sqlite:///support.db

# Optional DeepSeek-compatible OpenAI client. Leave empty to disable /ask.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_QUESTION_MAX_LENGTH=500

LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
